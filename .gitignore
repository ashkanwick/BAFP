# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
notebooks/*.nbconvert.ipynb

# Data — regenerate with src/scraper.py + src/preprocess.py
data/*.csv
data/**/*.csv

# Model weights — regenerate with src/model_training.py
models/**

# Downloaded fonts & generated figures
assets/fonts/*.ttf
assets/figures/*.png



# HuggingFace cache (can be several hundred MB)
.cache/
*.log

# IDE & Scratch
.zcode/
scratch/
app_bak_*.py
run_backups.bat
stop_backups.bat

# Session backup points & editor temp files — never ship these
app.py.bak-*
*.tmp.*

